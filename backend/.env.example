# Copy to .env to override the defaults. All values are optional.

# Port the API listens on (the Vite dev server proxies /api to it).
PORT=4000

# Address the API binds to. 127.0.0.1 keeps it reachable from this computer only.
HOST=127.0.0.1

# SQLite database file (created automatically). Relative paths are resolved from the backend folder.
DATABASE_PATH=data/cyberlab.sqlite
